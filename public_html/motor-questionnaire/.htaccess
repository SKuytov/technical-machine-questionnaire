# Технически въпросник — настройки за Apache (SuperHosting / cPanel)
Options -Indexes
DirectoryIndex index.php

# Принудително HTTPS (махнете # ако имате SSL сертификат — препоръчително)
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<FilesMatch "^(_paths\.php|\.user\.ini|\.htaccess)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
